# Copy to .env.prod (never commit .env.prod) and fill in real values.
# Consumed by docker-compose.prod.yml -- passed into the containers as real
# environment variables, never baked into an image layer.

# --- Django (config.settings.prod) ---
SECRET_KEY=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Postgres (shared by the db and backend services) ---
DB_NAME=nestmart_imas
DB_USER=nestmart_imas
DB_PASSWORD=

# --- Frontend build arg (baked into the Next.js build -- NEXT_PUBLIC_* vars
# are inlined at build time, so this must point at the public API origin
# reachable from users' browsers, not the internal "backend" service name) ---
NEXT_PUBLIC_API_URL=https://api.example.com
